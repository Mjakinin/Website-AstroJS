---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import NavigationMobile from "../components/NavigationMobile.astro";
import { GoogleTagmanager, GoogleTagmanagerNoscript } from '@digi4care/astro-google-tagmanager';

const { title, description, navMode } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Maxim Mjakinin" />
    <meta name="application-name" content="Maxim Mjakinin" />

    <link rel="icon" type="image/svg+xml" href="/favicon1.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
    <link rel="manifest" href="/manifest.json" />

    <title>{title}</title>
    <GoogleTagmanager id="G-8KQPMT3NVB" partytown={false} />
  </head>
    
  <body class="font-mono dark:bg-light bg-dark dark:text-dark text-light">
    <main id="" class="text-half-sm sm:text-xl md:text-2xl">

      <div id="popup-overlay"></div>
      <div id="popup" class="popup">
        <div class="popup-content">
          <span class="close-btn" onclick="closePopup()">&times;</span>
          <h2>Urlaubsankündigung</h2>
          <p style="text-align: left;">Ich bin derzeit im Urlaub und werde ab <b>01.09</b> zurück sein. In dringenden Fällen erreichen Sie mich unter <b>maxim.mjakinin@gmail.com</b> oder <b>WhatsApp</b><br />Vielen Dank für Ihr Verständnis.</p>
        </div>
      </div>

      <Header navMode={navMode} />
      <article class="page">

        <GoogleTagmanagerNoscript id="G-8KQPMT3NVB"/>

        <!-- Google tag (gtag.js) -->
        <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-8KQPMT3NVB"></script>
        <script type="text/partytown">
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-8KQPMT3NVB');
        </script>

        <slot />
      </article>
      <Footer />
      <NavigationMobile navMode={navMode} />
    </main>
     <script src="../js/pagetransition.js"></script>
    <script src="../js/urlaub.js"></script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
<style is:global>
  @import "../styles/base.css";
</style>