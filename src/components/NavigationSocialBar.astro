---
import NavigationSocial from "./NavigationSocial.astro";
import NavigationSocialIcon from "./NavigationSocialIcon.astro";
---
<NavigationSocial />
<div
  id="colorSwitch"
  class="hover:cursor-pointer dark:bg-dark bg-light rounded-full p-1 transition-transform duration-300 transform hover:scale-110 flex items-center justify-center shrink-0"
  title="Toggle light/dark mode"
  aria-label="Toggle light/dark mode"
>
  <img src="/icons/sun.svg" alt="sun" class="w-6 h-6" />
</div>
