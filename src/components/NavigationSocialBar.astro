---
import NavigationSocial from "./NavigationSocial.astro";
import NavigationSocialIcon from "./NavigationSocialIcon.astro";
---
<NavigationSocial />
<button
  id="colorSwitch"
  type="button"
  class="relative group top-0 hover:-top-1 transition-[top] ease duration-300 flex items-center justify-center focus:outline-none cursor-pointer text-white hover:text-amber-400 dark:text-gray-800 dark:hover:text-blue-600 bg-transparent border-0 p-0"
  title="Toggle light/dark mode"
  aria-label="Toggle light/dark mode"
>
  <span class="w-[30px] h-[30px] flex items-center justify-center text-inherit">
    <svg class="w-[26px] h-[26px] fill-current" viewBox="0 0 24 24">
