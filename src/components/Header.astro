---
import NavigationLinks from "../components/NavigationLinks.astro";
import NavigationLinksService from "../components/NavigationLinksService.astro";
import NavigationSocialBar from "../components/NavigationSocialBar.astro";

const { navMode } = Astro.props;
---

<header class="sticky top-3 z-50 px-4 mb-6 w-full max-w-5xl mx-auto">
  <div class="backdrop-blur-xl dark:bg-white/80 bg-[#0d1117]/80 border dark:border-gray-200 border-white/10 rounded-2xl px-5 py-3 shadow-lg flex items-center justify-between transition-all duration-300">
    
    <!-- Left: Clean Domain Brand -->
    <a href="/" class="flex items-center group">
      <span class="font-bold text-base sm:text-lg dark:text-gray-900 text-white tracking-tight group-hover:text-blue-400 transition-colors font-mono">
        maxim<span class="text-blue-500">.tk</span>
      </span>
    </a>

    <!-- Center: Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 dark:bg-gray-100/80 bg-white/5 p-1 rounded-full border dark:border-gray-200 border-white/5">
      {navMode === "service" ? <NavigationLinksService /> : <NavigationLinks />}
    </nav>

    <!-- Right: Theme Switch + Social Icons -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:block">
        <nav class="flex items-center justify-center gap-x-4">
          <NavigationSocialBar />
        </nav>
      </div>

      <button
        id="farbenwechsel"
        type="button"
        class="cursor-pointer text-white hover:text-amber-400 dark:text-gray-800 dark:hover:text-blue-600 block lg:hidden transition-all duration-300 p-2 focus:outline-none bg-white/10 dark:bg-gray-100 hover:bg-white/20 dark:hover:bg-gray-200 rounded-full"
        title="Toggle light/dark mode"
        aria-label="Toggle light/dark mode"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1zm0 18a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1zm9-9a1 1 0 0 1 0 2h-2a1 1 0 1 1 0-2h2zM5 12a1 1 0 0 1-1 1H2a1 1 0 1 1 0-2h2a1 1 0 0 1 1 1zm13.364-7.364a1 1 0 0 1 0 1.414l-1.414 1.414a1 1 0 1 1-1.414 1.414l1.414-1.414a1 1 0 0 1 1.414 0zM7.05 16.95a1 1 0 0 1 0 1.414l-1.414 1.414a1 1 0 1 1-1.414-1.414l1.414-1.414a1 1 0 0 1 1.414 0zm11.314 11.314a1 1 0 0 1-1.414 0l-1.414-1.414a1 1 0 1 1 1.414-1.414l1.414 1.414a1 1 0 0 1 0 1.414zM7.05 7.05a1 1 0 0 1-1.414 0L4.222 5.636a1 1 0 1 1 1.414-1.414l1.414 1.414a1 1 0 0 1 0 1.414z"/>
        </svg>
      </button>
    </div>

  </div>
</header>
