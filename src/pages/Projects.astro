---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Projects & Robotics — Maxim Mjakinin"
  description="Robotics projects, spatial kinematics, ROS 2 pipelines, academic coursework, and GitHub repositories by Maxim Mjakinin (TUM M.Sc. Automation & Robotics)."
>
  <div class="layout projects-container max-w-5xl mx-auto pb-20">

    <!-- PAGE HERO & INTRO -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pt-2 pb-8 border-b dark:border-gray-200 border-[#21262d]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 border dark:border-blue-200 border-blue-500/20 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          <span>Open-Source Robotics & Research</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white dark:text-gray-900 !my-0 !before:content-none">
          Projects & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-sky-400">Robotics</span>
        </h1>
        <p class="text-sm sm:text-base dark:text-gray-600 text-gray-400 font-mono mt-2">
          M.Sc. Automation & Robotics · Technical University of Munich (TUM)
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://github.com/Mjakinin?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border dark:border-gray-300 border-white/10 dark:bg-white bg-[#161b22] dark:text-gray-800 text-white hover:border-blue-500 hover:text-blue-400 dark:hover:border-blue-600 dark:hover:text-blue-600 transition-all duration-300 shadow-sm"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
          <span>GitHub Profile ↗</span>
        </a>
      </div>
    </div>

    <!-- QUICK SECTION JUMP TABS -->
    <div class="flex items-center gap-2 overflow-x-auto py-4 scrollbar-none border-b dark:border-gray-100 border-[#21262d] text-xs font-mono">
      <span class="dark:text-gray-400 text-gray-500 whitespace-nowrap">Jump to:</span>
      <a href="#featured" class="px-3 py-1 rounded-full dark:bg-gray-100 dark:text-gray-800 bg-[#161b22] text-gray-300 hover:text-blue-400 border dark:border-gray-200 border-[#21262d] whitespace-nowrap transition-colors">Featured Projects</a>
      <a href="#certificates" class="px-3 py-1 rounded-full dark:bg-gray-100 dark:text-gray-800 bg-[#161b22] text-gray-300 hover:text-blue-400 border dark:border-gray-200 border-[#21262d] whitespace-nowrap transition-colors">Certificates</a>
      <a href="#coursework" class="px-3 py-1 rounded-full dark:bg-gray-100 dark:text-gray-800 bg-[#161b22] text-gray-300 hover:text-blue-400 border dark:border-gray-200 border-[#21262d] whitespace-nowrap transition-colors">TUM Coursework</a>
      <a href="#all-repos" class="px-3 py-1 rounded-full dark:bg-gray-100 dark:text-gray-800 bg-[#161b22] text-gray-300 hover:text-blue-400 border dark:border-gray-200 border-[#21262d] whitespace-nowrap transition-colors">All Repositories</a>
    </div>

    <!-- FEATURED ROBOTICS REPOSITORIES -->
    <div id="featured" class="mt-10 scroll-mt-24">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
          <h2 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0 !before:content-none">
            Featured Robotics & AI Repositories
          </h2>
        </div>
        <span class="text-xs font-mono dark:text-gray-500 text-gray-400 hidden sm:inline">5 Key Implementations</span>
      </div>

      <!-- 1. HERO PROJECT: Modern Robotics Solutions (Full Width Flagship) -->
      <div class="rounded-2xl border border-blue-500/50 overflow-hidden dark:bg-white bg-[#0d1117] shadow-xl relative group hover:border-blue-400 transition-all duration-300">
        <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-blue-500 via-cyan-400 to-indigo-500"></div>

        <!-- Top Banner Header -->
        <div class="bg-blue-500/10 px-6 py-4 flex flex-wrap items-center justify-between gap-3 border-b border-blue-500/20">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-blue-400">Flagship Robotics Implementation</span>
            <span class="text-xs px-2 py-0.5 rounded bg-blue-500/20 text-blue-300 font-mono hidden sm:inline">Northwestern University</span>
          </div>
          <a
            href="https://github.com/Mjakinin/modern-robotics-solution"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-blue-400 hover:text-blue-300 hover:underline transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
            <span>View Repository →</span>
          </a>
        </div>

        <!-- Content Body without redundant matrix box -->
        <div class="p-6 sm:p-8">
          <h3 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0 !before:content-none group-hover:text-blue-400 transition-colors">
            Modern Robotics: Mechanics, Planning, and Control Solutions
          </h3>
          <p class="text-sm sm:text-base dark:text-gray-700 text-gray-300 mt-3 leading-relaxed font-sans max-w-4xl" style="line-height: 1.8;">
            Complete Python implementation of modern spatial robotics foundations accompanying Northwestern University's curriculum. Features <strong>screw theory representations, Product of Exponentials (PoE)</strong> for open chains, numerical Newton-Raphson inverse kinematics, open/closed chain dynamics (Euler-Lagrange and recursive Newton-Euler algorithms), collision-free trajectory generation, and feedback control for industrial manipulators.
          </p>

          <!-- Tech Badges -->
          <div class="flex flex-wrap gap-2 mt-6 pt-5 border-t dark:border-gray-100 border-[#21262d]">
            <span class="text-xs px-3 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 font-medium border border-blue-500/20 font-mono">Python 3</span>
            <span class="text-xs px-3 py-1 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-300 font-medium border border-cyan-500/20 font-mono">Screw Theory (se(3))</span>
            <span class="text-xs px-3 py-1 rounded-full dark:bg-purple-50 dark:text-purple-700 bg-purple-500/10 text-purple-300 font-medium border border-purple-500/20 font-mono">Inverse Kinematics</span>
            <span class="text-xs px-3 py-1 rounded-full dark:bg-emerald-50 dark:text-emerald-700 bg-emerald-500/10 text-emerald-300 font-medium border border-emerald-500/20 font-mono">Manipulator Dynamics</span>
            <span class="text-xs px-3 py-1 rounded-full dark:bg-amber-50 dark:text-amber-700 bg-amber-500/10 text-amber-300 font-medium border border-amber-500/20 font-mono">Trajectory Optimization</span>
          </div>
        </div>
      </div>

      <!-- 4-COLUMN BALANCED GRID (4 NEBENEINANDER AUF DESKTOP) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-6">

        <!-- 2. Camera Rig Calibration (rigcal) -->
        <div class="rounded-2xl border dark:border-gray-200 border-[#30363d] overflow-hidden dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between hover:border-cyan-500 hover:shadow-lg hover:shadow-cyan-500/10 hover:scale-[1.01] transition-all duration-300 group">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">Computer Vision</span>
              <a href="https://github.com/Mjakinin/camera-rig-calibration" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-blue-400 hover:underline flex items-center gap-1">GitHub →</a>
            </div>
            <div class="p-5">
              <h3 class="text-base sm:text-lg font-bold dark:text-gray-900 text-white !my-0 !before:content-none group-hover:text-cyan-400 transition-colors">
                rigcal — Camera Rig Calibration
              </h3>
              <p class="text-xs sm:text-sm dark:text-gray-600 text-gray-400 mt-2.5 leading-relaxed font-sans">
                Extrinsic calibration for distributed static camera rigs with a single moving camera. Simulation workflows and RViz inspection.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4 pt-2 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-1.5 font-mono text-xs">
            <span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Python</span>
            <span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">ROS 2</span>
            <span class="px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">RViz</span>
          </div>
        </div>

        <!-- 3. ROS2 Robotics Playground -->
        <div class="rounded-2xl border dark:border-gray-200 border-[#30363d] overflow-hidden dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between hover:border-emerald-500 hover:shadow-lg hover:shadow-emerald-500/10 hover:scale-[1.01] transition-all duration-300 group">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">ROS 2 Middleware</span>
              <a href="https://github.com/Mjakinin/ros2-robotics-playground" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-blue-400 hover:underline flex items-center gap-1">GitHub →</a>
            </div>
            <div class="p-5">
              <h3 class="text-base sm:text-lg font-bold dark:text-gray-900 text-white !my-0 !before:content-none group-hover:text-emerald-400 transition-colors">
                ros2-robotics-playground
              </h3>
              <p class="text-xs sm:text-sm dark:text-gray-600 text-gray-400 mt-2.5 leading-relaxed font-sans">
                Hands-on robotics packages in ROS 2 on Ubuntu 24.04: custom controllers (<code class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md dark:bg-emerald-100 dark:text-emerald-800 bg-emerald-500/20 text-emerald-300 border dark:border-emerald-300 border-emerald-500/40">auto_turtle</code>), pub/sub topologies, and actions.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4 pt-2 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-1.5 font-mono text-xs">
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">ROS 2</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Python</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">Control Nodes</span>
          </div>
        </div>

        <!-- 4. Bachelor Thesis: Akari Solver (BA 1.7) -->
        <div class="rounded-2xl border border-blue-500/40 overflow-hidden dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between hover:border-blue-400 hover:shadow-lg hover:shadow-blue-500/10 hover:scale-[1.01] transition-all duration-300 group">
          <div>
            <div class="bg-blue-500/10 px-5 pt-4 pb-3 flex items-center justify-between border-b border-blue-500/20">
              <span class="text-xs font-mono text-blue-400 uppercase tracking-wider font-semibold">Thesis · 1.7</span>
              <div class="flex items-center gap-2">
                <a href="https://doc.neuro.tu-berlin.de/bachelor/2025-BA-MaximMjakinin.pdf" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-blue-400 hover:underline">PDF ↗</a>
                <a href="https://github.com/Mjakinin/bachelor-thesis-akari" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-blue-400 hover:underline">GitHub →</a>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-base sm:text-lg font-bold dark:text-gray-900 text-white !my-0 !before:content-none group-hover:text-blue-400 transition-colors">
                Akari Combinatorial Solver
              </h3>
              <p class="text-xs sm:text-sm dark:text-gray-600 text-gray-400 mt-2.5 leading-relaxed font-sans">
                Comparative research on deductive search heuristics, Ant Colony Optimization (ACO), and SAT solvers for the NP-complete Akari puzzle.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4 pt-2 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-1.5 font-mono text-xs">
            <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">C++</span>
            <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">ACO</span>
            <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 border border-blue-500/20">SAT Solving</span>
          </div>
        </div>

        <!-- 5. SimpleCNN Ziffernerkennung -->
        <div class="rounded-2xl border dark:border-gray-200 border-[#30363d] overflow-hidden dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between hover:border-purple-500 hover:shadow-lg hover:shadow-purple-500/10 hover:scale-[1.01] transition-all duration-300 group">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-purple-400 uppercase tracking-wider font-semibold">Deep Learning</span>
              <a href="https://github.com/Mjakinin/SimpleCNN-Ziffernerkennung" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-blue-400 hover:underline flex items-center gap-1">GitHub →</a>
            </div>
            <div class="p-5">
              <h3 class="text-base sm:text-lg font-bold dark:text-gray-900 text-white !my-0 !before:content-none group-hover:text-purple-400 transition-colors">
                SimpleCNN Ziffernerkennung
              </h3>
              <p class="text-xs sm:text-sm dark:text-gray-600 text-gray-400 mt-2.5 leading-relaxed font-sans">
                Convolutional Neural Network from scratch for handwritten digit perception: 2D convolution kernels, pooling, and backpropagation.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4 pt-2 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-1.5 font-mono text-xs">
            <span class="px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">Python</span>
            <span class="px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">CNNs</span>
            <span class="px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">Vision</span>
          </div>
        </div>

      </div>
    </div>

    <!-- CERTIFICATES & SPECIALIZATIONS -->
    <div id="certificates" class="mt-20 scroll-mt-24">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0 !before:content-none">
          Verified Certificates & Specializations
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Modern Robotics Specialization (Northwestern University) -->
        <a
          href="https://coursera.org/share/965d45eb7ea0ef149ed67ba07228e0fb"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-blue-500/40 rounded-2xl overflow-hidden hover:border-blue-400 hover:shadow-xl hover:shadow-blue-500/10 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm block group relative"
        >
          <div class="h-52 overflow-hidden relative bg-black/40">
            <img
              src="/cert/mr1.png"
              alt="Modern Robotics Specialization Certificate"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 flex items-center gap-2 bg-black/70 backdrop-blur-md rounded-lg px-2.5 py-1.5 border border-white/10">
              <img src="/icons/northwestern.svg" alt="Northwestern University" class="w-4 h-5 object-contain" />
              <span class="text-xs text-white font-medium">Northwestern University</span>
            </div>
            <div class="absolute top-3 right-3">
              <span class="text-xs px-2.5 py-1 rounded-full bg-blue-600 text-white font-semibold shadow-md flex items-center gap-1 font-mono">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Verified Specialization
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-blue-400 uppercase tracking-wider font-semibold">Coursera · Prof. Kevin Lynch</span>
              <span class="text-xs text-blue-400 group-hover:underline font-mono">Verify Credential ↗</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold dark:text-gray-900 text-white group-hover:text-blue-400 transition-colors !my-0 !before:content-none">
              Modern Robotics: Mechanics, Planning, and Control Specialization
            </h3>
            <p class="text-sm dark:text-gray-700 text-gray-300 mt-2.5 leading-relaxed font-sans">
              Rigorous 6-course specialization covering spatial motion representations, modern screw theory, the Product of Exponentials (PoE) formula, forward & numerical inverse kinematics, manipulator dynamics, and mobile manipulation control.
            </p>
            <div class="mt-4 pt-3 border-t dark:border-gray-200 border-[#21262d] flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Kinematics & Dynamics</span>
              <span class="px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Screw Theory (PoE)</span>
              <span class="px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">6 Courses Completed</span>
            </div>
          </div>
        </a>

        <!-- Siemens Basics of Robotics -->
        <a
          href="https://www.coursera.org/account/accomplishments/records/V1ZU9ZULG1ER"
          target="_blank"
          rel="noopener noreferrer"
          class="border dark:border-gray-200 border-[#30363d] rounded-2xl overflow-hidden hover:border-blue-500 hover:shadow-xl hover:shadow-blue-500/10 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm block group relative"
        >
          <div class="h-52 overflow-hidden relative bg-black/40">
            <img
              src="/cert/basicofrobotics.png"
              alt="Siemens Basics of Robotics Certificate"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>
            <div class="absolute top-3 left-3 flex items-center gap-2 bg-white/95 backdrop-blur-md rounded-lg px-2.5 py-1.5 border border-white/20">
              <img src="/icons/siemens.svg" alt="Siemens" class="h-4 w-auto object-contain" />
            </div>
            <div class="absolute top-3 right-3">
              <span class="text-xs px-2.5 py-1 rounded-full bg-blue-600 text-white font-semibold shadow-md flex items-center gap-1 font-mono">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Course Completed
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold">Coursera · Siemens</span>
              <span class="text-xs text-blue-400 group-hover:underline font-mono">Verify Credential ↗</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold dark:text-gray-900 text-white group-hover:text-blue-400 transition-colors !my-0 !before:content-none">
              Basics of Robotics
            </h3>
            <p class="text-sm dark:text-gray-700 text-gray-300 mt-2.5 leading-relaxed font-sans">
