    <script is:inline>
      const featured = [
        "modern-robotics-solution",
        "camera-rig-calibration",
        "ros2-robotics-playground",
        "bachelor-thesis-akari",
        "SimpleCNN-Ziffernerkennung",
        "Mjakinin"
      ];

      const langColors = {
        Python: "#3572A5", JavaScript: "#f1e05a", TypeScript: "#3178c6",
        C: "#555555", "C++": "#f34b7d", Rust: "#dea584",
        Go: "#00ADD8", Java: "#b07219", HTML: "#e34c26", CSS: "#563d7c",
        VHDL: "#adb2b8", Assembly: "#6E4C13", Haskell: "#5e5086"
      };

      fetch("https://api.github.com/users/Mjakinin/repos?sort=updated&per_page=100")
        .then(r => r.json())
        .then(repos => {
          const container = document.getElementById("all-repos");
          container.querySelectorAll(".skeleton-card").forEach(el => el.remove());
          const rest = repos.filter(r => !featured.includes(r.name) && !r.fork);

          if (rest.length === 0) {
            container.innerHTML = `<p class="text-sm dark:text-gray-400 text-gray-500 col-span-4">No additional repositories found.</p>`;
            return;
          }

          rest.forEach(repo => {
            const color = langColors[repo.language] || "#8b949e";
            const lang = repo.language
              ? `<div class="flex items-center gap-1.5"><span style="background:${color}" class="w-2.5 h-2.5 rounded-full inline-block"></span><span class="text-xs dark:text-gray-600 text-gray-400 font-mono">${repo.language}</span></div>`
              : `<span class="text-xs text-gray-500 font-mono italic">Code</span>`;
            const stars = repo.stargazers_count > 0
              ? `<div class="flex items-center gap-1 text-xs dark:text-gray-600 text-gray-400"><svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>${repo.stargazers_count}</div>`
              : "";
            container.innerHTML += `
              <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer"
                class="border dark:border-gray-200 border-[#30363d] rounded-xl p-3.5 dark:bg-white bg-[#0d1117] hover:border-blue-500 hover:scale-[1.02] transition-all duration-300 shadow-sm flex flex-col justify-between group">
                <div class="flex items-center gap-2 mb-2">
                  <svg class="w-4 h-4 dark:text-gray-400 text-gray-500 group-hover:text-blue-400 transition-colors shrink-0" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                  <p class="font-bold text-sm !leading-snug dark:text-gray-900 text-white !my-0 truncate group-hover:text-blue-400 transition-colors">${repo.name}</p>
                </div>
                <div class="flex items-center justify-between pt-2 border-t dark:border-gray-100 border-[#21262d]">
                  ${lang}
                  ${stars}
                </div>
              </a>`;
          });
        })
        .catch(() => {
          const container = document.getElementById("all-repos");
          container.querySelectorAll(".skeleton-card").forEach(el => el.remove());
          container.innerHTML = `<p class="text-sm dark:text-gray-400 text-gray-500 col-span-4">Could not load repositories.</p>`;
        });
    </script>

