---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Maxim - Projects & Robotics" description="Robotics projects, academic research, certificates, and GitHub repositories by Maxim Mjakinin (TUM M.Sc. Automation & Robotics).">
  <div class="layout">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-baseline justify-between -mt-20 md:mt-0 mb-4">
      <div>
        <h1 class="transition-transform duration-300 transform hover:scale-[1.01] !mb-2">
          Projects & Robotics
        </h1>
        <p class="text-sm sm:text-base dark:text-gray-700 text-gray-300 font-mono">
          M.Sc. Automation & Robotics · Technical University of Munich (TUM)
        </p>
      </div>
      <a href="https://github.com/Mjakinin?tab=repositories" target="_blank" rel="noopener noreferrer"
         class="text-xs sm:text-sm font-semibold text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1.5 mt-2 md:mt-0">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
        GitHub Profile ↗
      </a>
    </div>

    <!-- FEATURED ROBOTICS REPOSITORIES -->
    <div class="mt-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 class="!my-0 !text-xl md:!text-2xl font-bold">
          Featured Robotics & AI Repositories
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-4">

        <!-- 1. Modern Robotics Solutions (HERO PROJECT) -->
        <div class="md:col-span-2 lg:col-span-2 border border-blue-500/50 rounded-xl overflow-hidden hover:scale-[1.01] transition-transform duration-300 dark:bg-white bg-[#0d1117] dark:border-blue-400 shadow-sm flex flex-col justify-between">
          <div>
            <div class="bg-blue-500/10 px-5 pt-4 pb-3 flex items-center justify-between border-b border-blue-500/20">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
                <span class="text-xs font-mono text-blue-400 uppercase tracking-widest font-semibold">Specialization Implementation · Northwestern University</span>
              </div>
              <a href="https://github.com/Mjakinin/modern-robotics-solution"
                 target="_blank" rel="noopener noreferrer"
                 class="text-xs font-semibold text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
                GitHub Code →
              </a>
            </div>
            <div class="p-5">
              <p class="!my-1 text-xl font-bold !leading-snug dark:text-gray-900 text-white">
                Modern Robotics Programming Solutions
              </p>
              <p class="!my-2 text-sm sm:text-base !leading-relaxed dark:text-gray-700 text-gray-300">
                Complete Python solutions for Northwestern University's <em>Modern Robotics: Mechanics, Planning, and Control</em>. Covers spatial motion, screw theory, Product of Exponentials (PoE) formula, Newton-Raphson numerical inverse kinematics, open/closed chain dynamics (Euler-Lagrange & recursive Newton-Euler), trajectory generation, and manipulator feedback control.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="flex gap-2 flex-wrap pt-2 border-t dark:border-gray-200 border-[#21262d]">
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Python</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Screw Theory & PoE</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Inverse Kinematics</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Robot Dynamics</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Trajectory Planning</span>
            </div>
          </div>
        </div>

        <!-- 2. Camera Rig Calibration (rigcal) -->
        <div class="border dark:border-gray-200 border-[#30363d] rounded-xl overflow-hidden hover:border-blue-500 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest font-semibold">Computer Vision · RViz</span>
              <a href="https://github.com/Mjakinin/camera-rig-calibration"
                 target="_blank" rel="noopener noreferrer"
                 class="text-xs font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1">
                GitHub →
              </a>
            </div>
            <div class="p-5">
              <p class="!my-1 text-lg font-bold !leading-snug dark:text-gray-900 text-white">
                rigcal — Camera Rig Calibration
              </p>
              <p class="!my-2 text-sm !leading-relaxed dark:text-gray-600 text-gray-400">
                Extrinsic calibration system for distributed static camera rigs using a single moving calibration camera. Features reproducible simulation and real-world workflows, reprojection error minimization, and interactive 3D inspection in RViz.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="flex gap-2 flex-wrap pt-2 border-t dark:border-gray-200 border-[#21262d]">
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-[#1f2937] text-cyan-300 font-medium border dark:border-cyan-200 border-cyan-900">Python</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-[#1f2937] text-cyan-300 font-medium border dark:border-cyan-200 border-cyan-900">ROS / RViz</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-[#1f2937] text-cyan-300 font-medium border dark:border-cyan-200 border-cyan-900">Multi-Camera</span>
            </div>
          </div>
        </div>

        <!-- 3. ROS2 Robotics Playground -->
        <div class="border dark:border-gray-200 border-[#30363d] rounded-xl overflow-hidden hover:border-blue-500 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-green-400 uppercase tracking-widest font-semibold">ROS 2 Middleware</span>
              <a href="https://github.com/Mjakinin/ros2-robotics-playground"
                 target="_blank" rel="noopener noreferrer"
                 class="text-xs font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1">
                GitHub →
              </a>
            </div>
            <div class="p-5">
              <p class="!my-1 text-lg font-bold !leading-snug dark:text-gray-900 text-white">
                ros2-robotics-playground
              </p>
              <p class="!my-2 text-sm !leading-relaxed dark:text-gray-600 text-gray-400">
                Practical robotics development in ROS 2 on Ubuntu 24.04. Custom packages including autonomous controllers (<code class="text-xs font-mono">auto_turtle</code>), pub/sub communications, service clients, and modular launch architecture.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="flex gap-2 flex-wrap pt-2 border-t dark:border-gray-200 border-[#21262d]">
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-green-50 dark:text-green-700 bg-[#1f2937] text-green-300 font-medium border dark:border-green-200 border-green-900">ROS 2</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-green-50 dark:text-green-700 bg-[#1f2937] text-green-300 font-medium border dark:border-green-200 border-green-900">Python</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-green-50 dark:text-green-700 bg-[#1f2937] text-green-300 font-medium border dark:border-green-200 border-green-900">Navigation</span>
            </div>
          </div>
        </div>

        <!-- 4. Bachelor Thesis: Akari Solver -->
        <div class="border border-blue-500/40 rounded-xl overflow-hidden hover:border-blue-400 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between">
          <div>
            <div class="bg-blue-500/10 px-5 pt-4 pb-3 flex items-center justify-between border-b border-blue-500/20">
              <span class="text-xs font-mono text-blue-400 uppercase tracking-widest font-semibold">Bachelor Thesis · TU Berlin (1.7)</span>
              <div class="flex items-center gap-2">
                <a href="https://doc.neuro.tu-berlin.de/bachelor/2025-BA-MaximMjakinin.pdf"
                   target="_blank" rel="noopener noreferrer"
                   class="text-xs font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors">PDF</a>
                <a href="https://github.com/Mjakinin/bachelor-thesis-akari"
                   target="_blank" rel="noopener noreferrer"
                   class="text-xs font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1">
                  GitHub →
                </a>
              </div>
            </div>
            <div class="p-5">
              <p class="!my-1 text-lg font-bold !leading-snug dark:text-gray-900 text-white">
                Akari Combinatorial Solver
              </p>
              <p class="!my-2 text-sm !leading-relaxed dark:text-gray-600 text-gray-400">
                Comparative research on deductive search, Ant Colony Optimization (ACO), and SAT-based solvers for the NP-complete Akari puzzle. Analyzed combinatorial search spaces and metaheuristics for autonomous problem-solving.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="flex gap-2 flex-wrap pt-2 border-t dark:border-gray-200 border-[#21262d]">
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">C++</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">Optimization</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-[#1f2937] text-blue-300 font-medium border dark:border-blue-200 border-blue-900">SAT Solving</span>
            </div>
          </div>
        </div>

        <!-- 5. SimpleCNN Ziffernerkennung -->
        <div class="border dark:border-gray-200 border-[#30363d] rounded-xl overflow-hidden hover:border-blue-500 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between">
          <div>
            <div class="px-5 pt-4 pb-3 flex items-center justify-between border-b dark:border-gray-100 border-[#21262d]">
              <span class="text-xs font-mono text-purple-400 uppercase tracking-widest font-semibold">Deep Learning & Vision</span>
              <a href="https://github.com/Mjakinin/SimpleCNN-Ziffernerkennung"
                 target="_blank" rel="noopener noreferrer"
                 class="text-xs font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors flex items-center gap-1">
                GitHub →
              </a>
            </div>
            <div class="p-5">
              <p class="!my-1 text-lg font-bold !leading-snug dark:text-gray-900 text-white">
                SimpleCNN Ziffernerkennung
              </p>
              <p class="!my-2 text-sm !leading-relaxed dark:text-gray-600 text-gray-400">
                Convolutional Neural Network built from scratch for visual digit recognition. Implements 2D convolution kernels, activation functions, pooling, and backpropagation for visual perception.
              </p>
            </div>
          </div>
          <div class="px-5 pb-4">
            <div class="flex gap-2 flex-wrap pt-2 border-t dark:border-gray-200 border-[#21262d]">
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-purple-50 dark:text-purple-700 bg-[#1f2937] text-purple-300 font-medium border dark:border-purple-200 border-purple-900">Python</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-purple-50 dark:text-purple-700 bg-[#1f2937] text-purple-300 font-medium border dark:border-purple-200 border-purple-900">CNN</span>
              <span class="text-xs px-2.5 py-1 rounded-full dark:bg-purple-50 dark:text-purple-700 bg-[#1f2937] text-purple-300 font-medium border dark:border-purple-200 border-purple-900">Computer Vision</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- CERTIFICATES SECTION -->
    <div class="mt-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 class="!my-0 !text-xl md:!text-2xl font-bold">Verified Certificates & Specializations</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Modern Robotics Specialization -->
        <a href="https://coursera.org/share/965d45eb7ea0ef149ed67ba07228e0fb"
           target="_blank" rel="noopener noreferrer"
           class="border border-blue-500/40 rounded-xl overflow-hidden hover:border-blue-400 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm block group relative">
          <div class="h-48 overflow-hidden relative bg-black/40">
            <img
              src="/cert/mr1.png"
              alt="Modern Robotics Specialization Certificate"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex items-center gap-2 bg-black/60 backdrop-blur-md rounded-lg px-2.5 py-1.5 border border-white/10">
              <img src="/icons/northwestern.svg" alt="Northwestern University" class="w-4 h-5 object-contain" />
              <span class="text-xs text-white font-medium">Northwestern University</span>
            </div>
            <div class="absolute top-3 right-3">
              <span class="text-xs px-2.5 py-1 rounded-full bg-blue-600 text-white font-semibold shadow-md flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Specialization Completed
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-blue-400 uppercase tracking-widest font-semibold">Coursera · Prof. Kevin Lynch</span>
              <span class="text-xs text-blue-400 group-hover:underline font-mono">Verify Credential ↗</span>
            </div>
            <h3 class="!my-1 text-lg sm:text-xl font-bold dark:text-gray-900 text-white group-hover:text-blue-400 transition-colors">
              Modern Robotics: Mechanics, Planning, and Control Specialization
            </h3>
            <p class="!my-2 text-sm !leading-relaxed dark:text-gray-700 text-gray-300">
              Rigorous 6-course specialization covering spatial motion representations, modern screw theory, the Product of Exponentials (PoE) formula, forward & numerical inverse kinematics, open/closed chain dynamics (Euler-Lagrange and Newton-Euler algorithms), motion planning, and mobile manipulation control.
            </p>
            <div class="mt-4 pt-3 border-t dark:border-gray-200 border-[#21262d] flex flex-wrap gap-2">
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Kinematics & Dynamics</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Screw Theory (PoE)</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Motion Planning & Control</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">6 Courses</span>
            </div>
          </div>
        </a>

        <!-- Siemens Basics of Robotics -->
        <a href="https://www.coursera.org/account/accomplishments/records/V1ZU9ZULG1ER"
           target="_blank" rel="noopener noreferrer"
           class="border dark:border-gray-200 border-[#30363d] rounded-xl overflow-hidden hover:border-blue-500 hover:scale-[1.01] transition-all duration-300 dark:bg-white bg-[#0d1117] shadow-sm block group relative">
          <div class="h-48 overflow-hidden relative bg-black/40">
            <img
              src="/cert/basicofrobotics.png"
              alt="Siemens Basics of Robotics Certificate"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute top-3 left-3 flex items-center gap-2 bg-white/90 backdrop-blur-md rounded-lg px-2.5 py-1.5 border border-white/20">
              <img src="/icons/siemens.svg" alt="Siemens" class="h-4 w-auto object-contain" />
            </div>
            <div class="absolute top-3 right-3">
              <span class="text-xs px-2.5 py-1 rounded-full bg-blue-600 text-white font-semibold shadow-md flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Course Completed
              </span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest font-semibold">Coursera · Siemens</span>
              <span class="text-xs text-blue-400 group-hover:underline font-mono">Verify Credential ↗</span>
            </div>
            <h3 class="!my-1 text-lg sm:text-xl font-bold dark:text-gray-900 text-white group-hover:text-blue-400 transition-colors">
              Basics of Robotics
            </h3>
            <p class="!my-2 text-sm !leading-relaxed dark:text-gray-700 text-gray-300">
              Comprehensive overview of industrial robotics, mechanical and electrical robot components, kinematics, motion interpolation (PTP, CP, CIRC), drive systems, end effectors, human-robot collaboration (HRC), and safety compliance under ISO 10218 and the EU Machinery Directive.
            </p>
            <div class="mt-4 pt-3 border-t dark:border-gray-200 border-[#21262d] flex flex-wrap gap-2">
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-400 font-medium">Industrial Robotics</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-400 font-medium">Motion Strategies (PTP/CP)</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-400 font-medium">ISO 10218 Safety</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-400 font-medium">Automation</span>
            </div>
          </div>
        </a>

      </div>
    </div>

    <!-- CURRENT STUDIES & COURSEWORK (TU MUNICH - TUM EI) -->
    <div class="mt-16">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
          <h2 class="!my-0 !text-xl md:!text-2xl font-bold flex items-center gap-2">
            Academic Focus & Coursework · TU Munich (TUM)
          </h2>
        </div>
        <div class="hidden sm:flex items-center gap-2 bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20">
          <img src="/icons/tum.svg" alt="TUM" class="w-5 h-auto object-contain" />
          <span class="text-xs font-mono text-blue-400 font-semibold">TUM Department of EI</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

        <!-- 1. Technik autonomer Systeme (lowercase 'a') -->
        <div class="border dark:border-gray-200 border-[#30363d] rounded-xl p-5 dark:bg-white bg-[#0d1117] shadow-sm flex flex-col justify-between hover:border-blue-500 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-blue-400 uppercase tracking-widest font-semibold">TUM · Module</span>
