        TypeScript: "#3178c6",
        JavaScript: "#f1e05a",
        Go: "#00ADD8",
        Java: "#b07219",
        HTML: "#e34c26",
        CSS: "#563d7c",
        VHDL: "#adb2b8",
        Assembly: "#6E4C13",
        Haskell: "#5e5086"
      };

      fetch("https://api.github.com/users/Mjakinin/repos?sort=updated&per_page=100")
        .then((r) => r.json())
        .then((repos) => {
          const container = document.getElementById("repos-container");
          if (!container) return;
          container.querySelectorAll(".skeleton-card").forEach((el) => el.remove());
