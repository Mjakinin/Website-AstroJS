---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About Maxim Mjakinin — Automation & Robotics"
  description="About Maxim Mjakinin — M.Sc. in Automation & Robotics at TU Munich (TUM), B.Sc. in Computer Engineering from TU Berlin. Focus on spatial kinematics, ROS 2, and autonomous systems."
>
  <div class="layout about-container max-w-5xl mx-auto pb-20">

    <!-- PAGE HERO & LANGUAGE TOGGLE -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2 pb-8 border-b dark:border-gray-200 border-[#21262d]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 border dark:border-blue-200 border-blue-500/20 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
          <span>Munich, Germany · TU Munich (TUM)</span>
        </div>

        <!-- Clean Title without CSS '#' injection -->
        <div class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white dark:text-gray-900 !my-0" id="h1">
          About <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-sky-400">Maxim Mjakinin</span>
        </div>

        <!-- Clean Subtitle without CSS 'first-letter' drop-cap bug -->
        <div class="text-sm sm:text-base dark:text-gray-400 text-gray-400 font-mono mt-2" id="hero-sub">
          M.Sc. Student in Automation & Robotics · Robotics Software & Control
        </div>
      </div>

      <!-- Language Switcher Pill -->
      <div class="flex items-center gap-2 self-start sm:self-center">
        <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Language:</span>
        <button
          id="lang-toggle"
          onclick="toggleLang()"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-mono font-semibold border dark:border-gray-300 border-white/10 dark:bg-white bg-[#161b22] dark:text-gray-800 text-white hover:border-blue-500 hover:text-blue-400 dark:hover:border-blue-600 dark:hover:text-blue-600 transition-all duration-300 shadow-sm"
          title="Switch between English and Deutsch"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          <span id="lang-label">DE</span>
        </button>
      </div>
    </div>

    <!-- CLEAN HERO NARRATIVE (FULL WIDTH, NO CLUTTERED SIDEBAR) -->
    <div class="mt-8 max-w-4xl space-y-4">
      <p data-i18n="p1" class="text-base sm:text-lg dark:text-gray-800 text-gray-200 leading-relaxed font-sans !my-0" style="line-height: 1.8; text-align: left; -webkit-hyphens: none; hyphens: none;"></p>
      <p data-i18n="p2" class="text-base sm:text-lg dark:text-gray-700 text-gray-300 leading-relaxed font-sans !my-0" style="line-height: 1.8; text-align: left; -webkit-hyphens: none; hyphens: none;"></p>

      <div class="pt-4 flex flex-wrap items-center gap-3">
        <a
          href="https://www.linkedin.com/in/maximmjakin/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium bg-blue-600 hover:bg-blue-500 text-white transition-all duration-300 transform hover:scale-105 flex items-center gap-2 shadow-md shadow-blue-500/20"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          <span>LinkedIn Profile</span>
        </a>
        <a
          href="https://github.com/Mjakinin"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border dark:border-gray-300 border-white/10 dark:text-gray-800 text-gray-200 hover:border-gray-400 hover:text-white transition-all duration-300 transform hover:scale-105 flex items-center gap-2"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
          <span>GitHub Repos</span>
        </a>
        <a
          href="mailto:maxim.mjakinin@gmail.com"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium border border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/10 transition-all duration-300 transform hover:scale-105 flex items-center gap-2"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>Email Me</span>
        </a>
      </div>
    </div>

    <!-- ACADEMIC & ENGINEERING JOURNEY (TIMELINE / VERLAUF) -->
    <div class="mt-16">
      <div class="flex items-center gap-3 mb-10">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 data-i18n="hEducation" class="text-2xl sm:text-3xl font-bold dark:text-gray-900 text-white !my-0">
          Academic Journey & Progression (Werdegang)
        </h2>
      </div>

      <!-- Vertical Continuous Timeline with Clean Station Spacing -->
      <div class="relative pl-6 sm:pl-10 border-l-2 dark:border-blue-200 border-blue-500/30 space-y-12">

        <!-- ================= STATION 1: TU MUNICH (CURRENT MASTER) ================= -->
        <div class="relative group">
          <!-- Timeline Glowing Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-blue-500 border-4 dark:border-white border-[#0d1117] shadow-[0_0_14px_rgba(59,130,246,0.8)]"></div>

          <div class="dark:bg-white bg-[#0d1117] border border-blue-500/40 rounded-2xl p-6 sm:p-8 shadow-sm hover:border-blue-400 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300 relative overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-blue-500"></div>

            <!-- Station Metadata Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-blue-500/15 text-blue-400 border border-blue-500/30">
                  Okt. 2026 – Present
                </span>
                <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Munich, Germany</span>
              </div>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-semibold">
                Active Master's Studies
              </span>
            </div>

            <!-- University Logo & Identity -->
            <div class="flex items-center gap-3.5 mb-3">
              <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 p-2 flex items-center justify-center shrink-0">
                <img src="/icons/tum.svg" alt="TUM Logo" class="w-full h-auto object-contain" />
              </div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0">
                  Technical University of Munich (TUM)
                </h3>
                <p class="text-xs font-mono text-blue-400 uppercase tracking-wider font-medium !my-0">
                  School of Computation, Information and Technology (CIT) · Dept. of EI
                </p>
              </div>
            </div>

            <!-- Degree & Specialization (Tightly bound together) -->
            <div class="mt-4 pt-4 border-t dark:border-gray-100 border-[#21262d] space-y-1">
              <div class="text-lg font-bold dark:text-blue-600 text-blue-400">
                M.Sc. Electrical and Computer Engineering (EI)
              </div>
              <div class="text-sm font-mono text-cyan-300 font-semibold uppercase tracking-wide">
                Specialization: Automation & Robotics
              </div>
            </div>

            <!-- Description -->
            <p data-i18n="tumDesc" class="mt-3 text-sm sm:text-base dark:text-gray-700 text-gray-300 leading-relaxed font-sans" style="line-height: 1.75;">
              Advanced graduate studies focused on <strong>spatial kinematics & dynamics (Screw Theory, PoE)</strong>, autonomous mobile systems, nonlinear control theory, Lyapunov stability, model predictive control (MPC), optimal decision making, and computer vision.
            </p>

            <!-- Station Tags -->
            <div class="mt-5 pt-4 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2.5 py-1 rounded-md dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border border-blue-500/20">Automation & Robotics</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border border-blue-500/20">Spatial Kinematics</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border border-blue-500/20">Nonlinear Control</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border border-blue-500/20">ROS 2</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-gray-100 dark:text-gray-700 bg-[#1f2937] text-gray-300">Munich</span>
            </div>
          </div>
        </div>

        <!-- ================= STATION 2: NORTHWESTERN SPECIALIZATION ================= -->
        <div class="relative group">
          <!-- Timeline Glowing Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-purple-500 border-4 dark:border-white border-[#0d1117] shadow-[0_0_14px_rgba(168,85,247,0.8)]"></div>

          <div class="dark:bg-white bg-[#0d1117] border border-purple-500/40 rounded-2xl p-6 sm:p-8 shadow-sm hover:border-purple-400 hover:shadow-lg hover:shadow-purple-500/10 transition-all duration-300 relative overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-purple-500"></div>

            <!-- Station Metadata Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-purple-500/15 text-purple-400 border border-purple-500/30">
                  2026
                </span>
                <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Coursera · Prof. Kevin Lynch</span>
              </div>
              <a
                href="https://coursera.org/share/965d45eb7ea0ef149ed67ba07228e0fb"
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 font-semibold hover:underline flex items-center gap-1"
              >
                <span>Verify Credential ↗</span>
              </a>
            </div>

            <!-- Institution Identity -->
            <div class="flex items-center gap-3.5 mb-3">
              <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 p-2 flex items-center justify-center shrink-0">
                <img src="/icons/northwestern.svg" alt="Northwestern University" class="w-full h-auto object-contain" />
              </div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0">
                  Northwestern University
                </h3>
                <p class="text-xs font-mono text-purple-400 uppercase tracking-wider font-medium !my-0">
                  Center for Robotics and Biosystems
                </p>
              </div>
            </div>

            <!-- Specialization Title (Tightly bound together) -->
            <div class="mt-4 pt-4 border-t dark:border-gray-100 border-[#21262d] space-y-1">
              <div class="text-lg font-bold dark:text-purple-600 text-purple-400">
                Modern Robotics: Mechanics, Planning, and Control Specialization
              </div>
              <div class="text-sm font-mono text-purple-300 font-semibold uppercase tracking-wide">
                Rigorous 6-Course Program Completed (2026)
              </div>
            </div>

            <!-- Description -->
            <p data-i18n="nwDesc" class="mt-3 text-sm sm:text-base dark:text-gray-700 text-gray-300 leading-relaxed font-sans" style="line-height: 1.75;">
              Intensive study of modern geometric robotics based on <strong>screw theory and Lie groups (SO(3), SE(3))</strong>. Implemented complete Python solutions for forward and numerical inverse kinematics (Newton-Raphson), open/closed chain dynamics (Euler-Lagrange and recursive Newton-Euler algorithms), collision-free trajectory generation, and mobile manipulator feedback control.
            </p>

            <!-- Station Tags -->
            <div class="mt-5 pt-4 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2.5 py-1 rounded-md dark:bg-purple-50 dark:text-purple-700 bg-purple-500/10 text-purple-300 border border-purple-500/20">Screw Theory (PoE)</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-purple-50 dark:text-purple-700 bg-purple-500/10 text-purple-300 border border-purple-500/20">Manipulator Dynamics</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-purple-50 dark:text-purple-700 bg-purple-500/10 text-purple-300 border border-purple-500/20">Trajectory Generation</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-purple-50 dark:text-purple-700 bg-purple-500/10 text-purple-300 border border-purple-500/20">Python Codebase</span>
            </div>
          </div>
        </div>

        <!-- ================= STATION 3: TU BERLIN (MASTER STUDIES & ML/CV) ================= -->
        <div class="relative group">
          <!-- Timeline Glowing Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-cyan-500 border-4 dark:border-white border-[#0d1117] shadow-[0_0_14px_rgba(6,182,212,0.8)]"></div>

          <div class="dark:bg-white bg-[#0d1117] border border-cyan-500/40 rounded-2xl p-6 sm:p-8 shadow-sm hover:border-cyan-400 hover:shadow-lg hover:shadow-cyan-500/10 transition-all duration-300 relative overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-cyan-500"></div>

            <!-- Station Metadata Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30">
                  Okt. 2025 – Okt. 2026
                </span>
                <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Berlin, Germany</span>
              </div>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 font-semibold">
                Graduate Studies · Robotics & Machine Learning
              </span>
            </div>

            <!-- University Logo & Identity -->
            <div class="flex items-center gap-3.5 mb-3">
              <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 p-2 flex items-center justify-center shrink-0">
                <img src="/icons/tu-berlin-short.svg" alt="TU Berlin Logo" class="w-full h-auto object-contain" />
              </div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0">
                  Technische Universität Berlin (TU Berlin)
                </h3>
                <p class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-medium !my-0">
                  Fakultät IV · Master Program in Computer Engineering
                </p>
              </div>
            </div>

            <!-- Degree & Focus (Tightly bound together) -->
            <div class="mt-4 pt-4 border-t dark:border-gray-100 border-[#21262d] space-y-1">
              <div class="text-lg font-bold dark:text-cyan-600 text-cyan-400">
                M.Sc. Computer Engineering (Graduate Studies)
              </div>
              <div class="text-sm font-mono text-cyan-300 font-semibold uppercase tracking-wide">
                Focus: Cognitive Systems, Machine Learning & Autonomous Robotics
              </div>
            </div>

            <!-- Description with official coursework highlights -->
            <p data-i18n="tubMasterDesc" class="mt-3 text-sm sm:text-base dark:text-gray-700 text-gray-300 leading-relaxed font-sans" style="line-height: 1.75;">
              Advanced graduate studies specializing in machine learning and autonomous robotic perception:
            </p>
            <ul class="mt-2 space-y-1.5 text-xs sm:text-sm font-mono dark:text-gray-700 text-gray-300 list-none pl-0">
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 font-bold">▸</span>
                <span><strong>Applications of Robotics and Autonomous Systems</strong> — Completed with grade <strong>1.0 (sehr gut)</strong> (9.0 LP)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 font-bold">▸</span>
                <span><strong>Machine Learning 1-X & Machine Learning 2-X</strong> (24.0 LP total) — Deep theoretical formulations & neural networks</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 font-bold">▸</span>
                <span><strong>Computer Vision Project</strong> — Development of <code class="text-xs font-mono">rigcal</code> for multi-camera rig calibration in ROS / RViz</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 font-bold">▸</span>
                <span><strong>Statistische Nachrichtentheorie</strong> (Statistical Communications Theory, 6.0 LP)</span>
              </li>
            </ul>

            <!-- Station Tags -->
            <div class="mt-5 pt-4 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-2.5 py-1 rounded-md dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Robotics (Grade 1.0)</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Machine Learning 1 & 2</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">Computer Vision (rigcal)</span>
              <span class="px-2.5 py-1 rounded-md dark:bg-cyan-50 dark:text-cyan-700 bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">TU Berlin</span>
            </div>
          </div>
        </div>

        <!-- ================= STATION 4: TU BERLIN (BACHELOR) ================= -->
        <div class="relative group">
          <!-- Timeline Glowing Node -->
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-4 h-4 rounded-full bg-red-500 border-4 dark:border-white border-[#0d1117] shadow-[0_0_14px_rgba(239,68,68,0.8)]"></div>

          <div class="dark:bg-white bg-[#0d1117] border border-red-500/40 rounded-2xl p-6 sm:p-8 shadow-sm hover:border-red-400 hover:shadow-lg hover:shadow-red-500/10 transition-all duration-300 relative overflow-hidden">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#C50E1F]"></div>

            <!-- Station Metadata Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-red-500/15 text-red-400 border border-red-500/30">
                  Okt. 2022 – Aug. 2025
                </span>
                <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Berlin, Germany</span>
              </div>
              <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 font-semibold">
                Graduated Nov. 2025 · B.Sc.
              </span>
            </div>

            <!-- University Logo & Identity -->
            <div class="flex items-center gap-3.5 mb-3">
              <div class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 p-2 flex items-center justify-center shrink-0">
                <img src="/icons/tu-berlin-short.svg" alt="TU Berlin Logo" class="w-full h-auto object-contain" />
              </div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold dark:text-gray-900 text-white !my-0">
                  Technische Universität Berlin (TU Berlin)
                </h3>
                <p class="text-xs font-mono text-red-400 uppercase tracking-wider font-medium !my-0">
                  Fakultät IV · Elektrotechnik und Informatik
                </p>
              </div>
            </div>

            <!-- Degree & Specialization (TIGHTLY GROUPED) -->
            <div class="mt-4 pt-4 border-t dark:border-gray-100 border-[#21262d] space-y-1">
              <div class="text-lg font-bold dark:text-red-600 text-red-400">
                B.Sc. Technische Informatik (Computer Engineering)
              </div>
              <div class="text-sm font-mono text-red-300 font-semibold uppercase tracking-wide">
                Bachelor Thesis Graded 1.7 (gut) · Erstprüfer: Prof. Dr. Benjamin Blankertz
              </div>
            </div>

            <!-- Description -->
            <p data-i18n="tubDesc" class="mt-3 text-sm sm:text-base dark:text-gray-700 text-gray-300 leading-relaxed font-sans" style="line-height: 1.75;">
              Comprehensive engineering foundation across systems programming, computer architecture, digital logic, operating systems, and discrete mathematics. 
              <strong>Bachelor Thesis:</strong> <em>Systematischer Vergleich von Ant Colony Optimization und Constraint Programming zur Lösung von Akari-Puzzles</em> (Erstprüfer: Prof. Dr. Benjamin Blankertz, Note <strong>1.7</strong>).
