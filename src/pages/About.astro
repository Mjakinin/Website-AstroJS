---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Maxim - About Me" description="About Maxim Mjakinin — M.Sc. in Automation & Robotics at TU Munich (TUM), B.Sc. in Computer Engineering from TU Berlin.">
  <div class="layout">

    <!-- HEADER & LANG TOGGLE -->
    <div class="flex items-baseline justify-between -mt-20 md:mt-0 mb-4">
      <div>
        <h1 id="h1" class="transition-transform duration-300 transform hover:scale-[1.01] !mb-1">
          About Me
        </h1>
        <p class="text-sm sm:text-base dark:text-gray-600 text-gray-400 font-mono">
          Robotics · Autonomous Systems · Control Theory
        </p>
      </div>
      <button
        id="lang-toggle"
        onclick="toggleLang()"
        class="px-3.5 py-1.5 rounded-lg text-xs font-mono font-semibold border dark:border-gray-300 border-gray-700 dark:text-gray-800 text-gray-200 hover:border-blue-500 hover:text-blue-400 dark:hover:border-blue-600 dark:hover:text-blue-600 transition-all duration-300 shrink-0 ml-4 shadow-sm"
      >
        DE
      </button>
    </div>

    <!-- INTRO PARAGRAPHS -->
    <div class="mt-6 space-y-4">
      <p data-i18n="p1" class="text-base sm:text-lg dark:text-gray-800 text-gray-200 leading-relaxed max-w-3xl"></p>
      <p data-i18n="p2" class="text-base sm:text-lg dark:text-gray-700 text-gray-300 leading-relaxed max-w-3xl"></p>
    </div>

    <!-- EDUCATION SECTION (WITH OFFICIAL TUM & TU BERLIN LOGOS) -->
    <div class="mt-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 data-i18n="hEducation" class="text-left transition-transform duration-300 transform hover:scale-[1.01] !my-0">
          Education & Academic Background
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- 1. Technical University of Munich (TUM) -->
        <div class="dark:bg-white bg-[#0d1117] border border-blue-500/40 rounded-2xl p-6 shadow-sm relative overflow-hidden flex flex-col justify-between hover:border-blue-400 hover:scale-[1.01] transition-all duration-300 group">
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-blue-500 rounded-l-2xl"></div>
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-xl bg-blue-500/10 border border-blue-500/20 p-2.5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <img src="/icons/tum.svg" alt="TUM Logo" class="w-full h-auto object-contain" />
                </div>
                <div>
                  <h3 class="!my-0 text-lg sm:text-xl font-bold dark:text-gray-900 text-white">
                    Technical University of Munich
                  </h3>
                  <p class="!my-0 text-xs font-mono text-blue-400 font-semibold tracking-wider uppercase">TUM · School of CIT / EI</p>
                </div>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 font-semibold shrink-0">
                Current
              </span>
            </div>

            <div class="mt-2">
              <p class="!my-0 text-base font-semibold dark:text-blue-600 text-blue-400">
                M.Sc. Electrical and Computer Engineering (EI)
              </p>
              <p class="!my-1 text-xs font-mono text-gray-400 uppercase tracking-wide">
                Major in Automation & Robotics
              </p>
              <p data-i18n="tumDesc" class="!my-3 text-sm dark:text-gray-700 text-gray-300 leading-relaxed">
                Specializing in Automation & Robotics, Autonomous Systems, Nonlinear Control, Optimal Decision Making, and Computer Vision.
              </p>
            </div>
          </div>

          <div class="pt-4 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-2">
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-gray-100 dark:text-gray-700 bg-[#1f2937] text-gray-300 font-mono">Munich, Germany</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-400 font-medium">Master of Science</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-gray-100 dark:text-gray-700 bg-[#1f2937] text-gray-300 font-medium">Active</span>
          </div>
        </div>

        <!-- 2. TU Berlin -->
        <div class="dark:bg-white bg-[#0d1117] border dark:border-gray-200 border-[#30363d] rounded-2xl p-6 shadow-sm relative overflow-hidden flex flex-col justify-between hover:border-red-400 hover:scale-[1.01] transition-all duration-300 group">
          <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#C50E1F] rounded-l-2xl"></div>
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-xl bg-red-500/10 border border-red-500/20 p-2.5 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                  <img src="/icons/tu-berlin-short.svg" alt="TU Berlin Logo" class="w-full h-auto object-contain" />
                </div>
                <div>
                  <h3 class="!my-0 text-lg sm:text-xl font-bold dark:text-gray-900 text-white">
                    TU Berlin
                  </h3>
                  <p class="!my-0 text-xs font-mono text-red-400 font-semibold tracking-wider uppercase">Technische Universität Berlin</p>
                </div>
              </div>
              <span class="text-xs px-2.5 py-1 rounded-full bg-red-500/10 text-red-400 border border-red-500/20 font-semibold shrink-0">
                Grade 1.7 Thesis
              </span>
            </div>

            <div class="mt-2">
              <p class="!my-0 text-base font-semibold dark:text-red-600 text-red-400">
                B.Sc. Computer Engineering (Technische Informatik)
              </p>
              <p class="!my-1 text-xs font-mono text-gray-400 uppercase tracking-wide">
                Hardware & Software Full Stack
              </p>
              <p data-i18n="tubDesc" class="!my-3 text-sm dark:text-gray-700 text-gray-300 leading-relaxed">
                Broad foundation across systems programming, computer architecture, algorithms, and AI. Thesis: Ant Colony Optimization, Constraint Programming, and SAT for Akari puzzle solving.
              </p>
            </div>
          </div>

          <div class="pt-4 border-t dark:border-gray-100 border-[#21262d] flex flex-wrap gap-2">
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-gray-100 dark:text-gray-700 bg-[#1f2937] text-gray-300 font-mono">Berlin, Germany</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-red-50 dark:text-red-700 bg-red-500/10 text-red-400 font-medium">Bachelor of Science</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full dark:bg-gray-100 dark:text-gray-700 bg-[#1f2937] text-gray-300 font-medium">Completed</span>
          </div>
        </div>

      </div>
    </div>

    <!-- WHERE I'M HEADED / ROBOTICS FOCUS -->
    <div class="mt-14 relative">
      <div class="flex items-center gap-3 justify-end mb-4">
        <h2 data-i18n="h2" class="text-right transition-transform duration-300 transform hover:scale-[1.01] !my-0"></h2>
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
      </div>

      <div class="dark:bg-white bg-[#0d1117] border dark:border-gray-200 border-[#30363d] rounded-2xl p-6 md:p-8 shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-500 via-blue-400 to-transparent rounded-l-2xl"></div>
        <p data-i18n="p3" class="text-base sm:text-lg dark:text-gray-800 text-gray-200 leading-relaxed !my-0"></p>

        <div class="flex flex-wrap gap-2 mt-6">
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Spatial Kinematics & Dynamics</span>
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Screw Theory & PoE</span>
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Nonlinear Control & Lyapunov</span>
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Autonomous Systems</span>
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Computer Vision & Calibration</span>
          <span class="text-xs px-3 py-1.5 rounded-full dark:bg-blue-50 dark:text-blue-700 bg-blue-500/10 text-blue-300 border dark:border-blue-200 border-blue-500/20 font-medium">Optimal Decision Making (MPC)</span>
        </div>
      </div>
    </div>

    <!-- WHAT I BUILD & ENGINEERING STACK -->
    <div class="mt-12 relative">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
        <h2 data-i18n="h3" class="text-left transition-transform duration-300 transform hover:scale-[1.01] !my-0"></h2>
      </div>

      <div class="dark:bg-white bg-[#0d1117] border dark:border-gray-200 border-[#30363d] rounded-2xl p-6 md:p-8 shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-green-500 via-blue-400 to-transparent rounded-l-2xl"></div>
        <p data-i18n="p4" class="text-base sm:text-lg dark:text-gray-800 text-gray-200 leading-relaxed !my-0"></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-6">
          <!-- Robotics -->
          <div class="p-3.5 rounded-xl dark:bg-gray-50 bg-[#161b22] border dark:border-gray-200 border-[#21262d]">
            <p class="!my-0 text-xs font-mono uppercase text-green-400 font-bold mb-2">Robotics & Control</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs px-2 py-0.5 rounded bg-green-500/10 text-green-400 font-medium">ROS 2</span>
              <span class="text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-medium">Modern Robotics</span>
              <span class="text-xs px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-medium">Screw Theory</span>
              <span class="text-xs px-2 py-0.5 rounded bg-gray-500/10 text-gray-300 font-medium">RViz</span>
            </div>
          </div>

          <!-- Languages -->
          <div class="p-3.5 rounded-xl dark:bg-gray-50 bg-[#161b22] border dark:border-gray-200 border-[#21262d]">
            <p class="!my-0 text-xs font-mono uppercase text-blue-400 font-bold mb-2">Languages & Core</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-medium">Python</span>
              <span class="text-xs px-2 py-0.5 rounded bg-pink-500/10 text-pink-400 font-medium">C++</span>
              <span class="text-xs px-2 py-0.5 rounded bg-yellow-500/10 text-yellow-400 font-medium">C</span>
              <span class="text-xs px-2 py-0.5 rounded bg-gray-500/10 text-gray-300 font-medium">Linux / Bash</span>
            </div>
          </div>

          <!-- Perception -->
          <div class="p-3.5 rounded-xl dark:bg-gray-50 bg-[#161b22] border dark:border-gray-200 border-[#21262d]">
            <p class="!my-0 text-xs font-mono uppercase text-cyan-400 font-bold mb-2">Vision & Perception</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-medium">OpenCV</span>
              <span class="text-xs px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-medium">rigcal (Rig Calibration)</span>
              <span class="text-xs px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-medium">CNNs</span>
              <span class="text-xs px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 font-medium">PyTorch</span>
            </div>
          </div>

          <!-- Systems & Embedded -->
          <div class="p-3.5 rounded-xl dark:bg-gray-50 bg-[#161b22] border dark:border-gray-200 border-[#21262d]">
            <p class="!my-0 text-xs font-mono uppercase text-orange-400 font-bold mb-2">Hardware & Embedded</p>
            <div class="flex flex-wrap gap-1.5">
              <span class="text-xs px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 font-medium">Embedded Systems</span>
              <span class="text-xs px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 font-medium">Circuits & Logic</span>
              <span class="text-xs px-2 py-0.5 rounded bg-gray-500/10 text-gray-300 font-medium">VHDL / Arch</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CURRENTLY LOOKING FOR / INVITING CONTACT -->
    <div class="mt-12 relative mb-16">
      <div class="flex items-center gap-3 justify-end mb-4">
        <h2 data-i18n="h4" class="text-right transition-transform duration-300 transform hover:scale-[1.01] !my-0"></h2>
        <span class="w-8 h-px dark:bg-blue-500 bg-blue-400 shrink-0"></span>
      </div>

      <div class="dark:bg-white bg-[#0d1117] border border-blue-500/40 rounded-2xl p-6 md:p-8 shadow-sm relative overflow-hidden">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-blue-500 via-green-400 to-transparent rounded-l-2xl"></div>

        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
            </span>
            <span class="text-xs sm:text-sm font-semibold dark:text-green-600 text-green-400" data-i18n="status"></span>
          </div>
          <span class="text-xs font-mono dark:text-gray-500 text-gray-400">Munich, Bavaria</span>
        </div>

        <p data-i18n="p5" class="text-base sm:text-lg dark:text-gray-800 text-gray-200 leading-relaxed !my-0"></p>

        <!-- Inviting Action Buttons -->
        <div class="mt-6 flex flex-wrap items-center gap-3 pt-4 border-t dark:border-gray-100 border-[#21262d]">
          <a href="https://www.linkedin.com/in/maximmjakin/" target="_blank" rel="noopener noreferrer"
             class="px-4 py-2.5 rounded-xl font-medium bg-blue-600 hover:bg-blue-500 text-white transition-all duration-300 transform hover:scale-105 hover:shadow-lg hover:shadow-blue-500/30 text-sm flex items-center gap-2">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            LinkedIn Profile ↗
          </a>
          <a href="mailto:maxim.mjakinin@gmail.com"
             class="px-4 py-2.5 rounded-xl font-medium border border-blue-500/40 text-blue-400 hover:bg-blue-500/10 transition-all duration-300 transform hover:scale-105 text-sm flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email Me
          </a>
          <a href="/Projects"
             class="px-4 py-2.5 rounded-xl font-medium border dark:border-gray-200 border-gray-700 dark:text-gray-700 text-gray-300 hover:border-gray-400 transition-all duration-300 transform hover:scale-105 text-sm">
            View Projects & Repos →
          </a>
        </div>
      </div>
    </div>

    <script src="../js/themeHandler.js"></script>
    <script src="../js/pageHandler.js"></script>

    <script is:inline>
      const translations = {
        en: {
          h1: "About Me",
          p1: `I'm Maxim, currently pursuing my Master of Science in Electrical and Computer Engineering (EI) with a major in <strong>Automation & Robotics</strong> at the <strong>Technical University of Munich (TUM)</strong>. Prior to TUM, I completed my Bachelor of Science in Computer Engineering at <strong>TU Berlin</strong>, where my bachelor's thesis on combinatorial optimization and metaheuristic solvers for the NP-complete Akari puzzle was graded 1.7.`,
          p2: `My academic and engineering background spans the complete stack: from computer architecture, systems programming, and electronic circuit fundamentals to optimization algorithms, machine learning, and control theory. This interdisciplinary foundation allows me to approach robotics challenges with an understanding of both physical hardware constraints and mathematical algorithms.`,
          hEducation: "Education & Academic Background",
          tumDesc: `Specializing in Automation & Robotics, Autonomous Systems, Nonlinear Control, Optimal Decision Making, and Computer Vision.`,
          tubDesc: `Broad foundation across systems programming, computer architecture, algorithms, and AI. Thesis: Ant Colony Optimization, Constraint Programming, and SAT for Akari puzzle solving (graded 1.7).`,
          h2: "Robotics & Specialization",
          p3: `In my Master's at TUM, I deliberately focus on <strong>Automation & Robotics, Autonomous Systems, Control Theory, and Computer Vision</strong>. I am fascinated by embodied intelligence — systems that perceive dynamic real-world environments, calculate optimal trajectories, and act with mechanical precision — whether that's industrial manipulators, multi-camera calibration rigs, or autonomous mobile robots.`,
          h3: "Hands-On Engineering & Stack",
          p4: `Alongside university coursework, I actively build open-source robotics projects. I completed Northwestern University's rigorous 6-course <em>Modern Robotics: Mechanics, Planning, and Control</em> Specialization, implementing complete Python solutions for screw theory, forward/inverse kinematics, dynamics, and simulation. My GitHub projects range from camera rig calibration pipelines (<code>rigcal</code>) and ROS 2 controllers to handwritten digit CNNs and combinatorial optimization solvers.`,
          h4: "Current Status & Opportunities",
          p5: `I am currently based in Munich, Germany. I am open to working student positions (Werkstudent), robotics internships, and thesis collaborations in robotics, autonomous systems, computer vision, and intelligent control engineering.`,
          status: "Open to opportunities · Munich / Hybrid",
        },
        de: {
          h1: "Über mich",
          p1: `Ich bin Maxim und studiere Elektro- und Informationstechnik (EI) mit dem Schwerpunkt <strong>Automation & Robotics</strong> im Master an der <strong>Technischen Universität München (TUM)</strong>. Meinen Bachelor in Technischer Informatik habe ich an der <strong>TU Berlin</strong> abgeschlossen — mit einer Bachelorarbeit über kombinatorische Optimierungsalgorithmen und Metaheuristiken für das Akari-Rätsel, bewertet mit 1,7.`,
          p2: `Mein Hintergrund verbindet Hardware und Software: von Rechnerarchitektur, Systemprogrammierung und Grundlagen der Elektrotechnik bis hin zu Algorithmen, maschinellem Lernen und Regelungstechnik. Diese Breite ermöglicht es mir, komplexe Robotik-Herausforderungen sowohl von der physikalischen als auch von der algorithmischen Seite zu verstehen.`,
          hEducation: "Ausbildung & Werdegang",
          tumDesc: `Schwerpunkte in Automation & Robotics, autonomen Systemen, nichtlinearer Regelung, optimaler Entscheidungsfindung und Computer Vision.`,
          tubDesc: `Fundierte Ausbildung in Systemprogrammierung, Rechnerorganisation, Algorithmen und KI. Bachelorarbeit: Ant Colony Optimization, Constraint Programming und SAT (Note 1,7).`,
          h2: "Fokus Robotik & Automation",
          p3: `Im Master an der TUM konzentriere ich mich gezielt auf <strong>Automation & Robotics, autonome Systeme, Regelungstechnik und Computer Vision</strong>. Mein Ziel ist es, an Systemen zu arbeiten, die die reale Welt erfassen, optimale Entscheidungen treffen und mechanisch präzise handeln — seien es Robotermanipulatoren, Kamerasysteme oder autonome Fahrzeuge.`,
          h3: "Praktische Projekte & Tech Stack",
          p4: `Neben dem Studium setze ich mein Wissen in praktischen Projekten um. Ich habe die 6-teilige <em>Modern Robotics</em>-Spezialisierung der Northwestern University abgeschlossen und vollständige Python-Lösungen für Schraubentheorie, Kinematik, Dynamik und Regelung entwickelt. Auf GitHub entwickle ich u.a. Multi-Kamera-Kalibrierungstools (<code>rigcal</code>), ROS 2-Nodes, CNNs für Computer Vision und Algorithmen.`,
          h4: "Aktuell auf der Suche nach",
          p5: `Ich lebe in München. Ich bin offen für Werkstudentenstellen, Praktika und Projektarbeiten in den Bereichen Robotik, autonome Systeme, Computer Vision und Regelungstechnik.`,
          status: "Offen für Angebote · München / Hybrid",
        },
      };

      let currentLang = "en";

      function applyLang(lang) {
        const t = translations[lang];
        document.getElementById("h1").innerHTML = t.h1;
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (t[key]) el.innerHTML = t[key];
        });
        document.getElementById("lang-toggle").textContent = lang === "en" ? "DE" : "EN";
      }

      function toggleLang() {
        currentLang = currentLang === "en" ? "de" : "en";
        applyLang(currentLang);
      }

      applyLang(currentLang);
    </script>
  </div>
</Layout>
